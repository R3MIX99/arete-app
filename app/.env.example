# Copia este archivo como ".env" en la raíz de app/ y completa tus propias
# credenciales de Supabase. El archivo ".env" nunca debe subirse al
# repositorio (ver .gitignore).
#
# Se usa la clave publicable/anónima de Supabase, segura para exponer en un
# cliente móvil porque el acceso real a los datos queda controlado por las
# políticas de Row Level Security definidas en supabase/.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anonima-publica
